{
  "name": "hariari",
  "version": "0.6.8",
  "description": "AI agent terminal orchestrator for vibe coders",
  "author": {
    "name": "Hariari",
    "email": "hello@hariari.app"
  },
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/hariari-app/hariari",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run runtime:build && electron-vite dev",
    "build": "npm run runtime:build && electron-vite build",
    "preview": "electron-vite preview",
    "pretest": "npm run runtime:build",
    "test": "vitest run",
    "pretest:watch": "npm run runtime:build",
    "test:watch": "vitest",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write \"src/**/*.{ts,css,html}\"",
    "postinstall": "electron-builder install-app-deps",
    "runtime:build": "node scripts/runtime-build.mjs",
    "runtime:sea-smoke": "vitest run tests/integration/runtime-packaging-sea.test.ts",
    "runtime:package-smoke": "node scripts/runtime-package-smoke.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "node scripts/runtime-require-platform.mjs linux && npm run build && electron-builder --linux",
    "dist:mac": "node scripts/runtime-require-platform.mjs darwin && npm run build && electron-builder --mac",
    "dist:win": "node scripts/runtime-require-platform.mjs win32 && npm run build && electron-builder --win"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/search": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.3",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^9.39.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "esbuild": "0.21.5",
    "eslint": "^9.0.0",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.4.0",
    "sharp": "^0.34.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.0"
  }
}
